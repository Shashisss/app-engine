"""Streamlit calculator generated by the App Engine. Runs standalone."""
import json
import math
import os
import sqlite3
from datetime import datetime

import pandas as pd
import streamlit as st

SPEC = json.loads(r'''{{ spec_json }}''')
FIELDS = SPEC["fields"]
DB_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "history.sqlite")


def monthly_payment(principal: float, rate: float, years: float) -> float:
    n = max(years, 0) * 12
    if n <= 0:
        return 0.0
    monthly_rate = rate / 100 / 12
    if monthly_rate == 0:
        return principal / n
    return principal * monthly_rate / (1 - (1 + monthly_rate) ** -n)


def future_value(initial: float, monthly: float, rate: float, years: float) -> float:
    months = max(years, 0) * 12
    monthly_rate = rate / 100 / 12
    if monthly_rate == 0:
        return initial + monthly * months
    grown = initial * (1 + monthly_rate) ** months
    contributions = monthly * (((1 + monthly_rate) ** months - 1) / monthly_rate)
    return grown + contributions


def init_db() -> None:
    inputs = ", ".join(f'"{f["name"]}" REAL' for f in FIELDS)
    with sqlite3.connect(DB_PATH) as conn:
        conn.execute(
            f"CREATE TABLE IF NOT EXISTS runs (id INTEGER PRIMARY KEY AUTOINCREMENT, "
            f"created_at TEXT NOT NULL, {inputs}, result REAL)"
        )


def save(values: dict, result: float) -> None:
    names = ", ".join(f'"{k}"' for k in values)
    marks = ", ".join("?" for _ in values)
    with sqlite3.connect(DB_PATH) as conn:
        conn.execute(
            f"INSERT INTO runs (created_at, {names}, result) VALUES (?, {marks}, ?)",
            (datetime.now().isoformat(timespec="seconds"), *values.values(), result),
        )


def fetch() -> pd.DataFrame:
    with sqlite3.connect(DB_PATH) as conn:
        return pd.read_sql_query("SELECT * FROM runs ORDER BY id DESC", conn)


init_db()
st.set_page_config(page_title=SPEC["name"], page_icon="🧮", layout="wide")
st.title(SPEC["name"])
st.caption(SPEC["description"])

left, right = st.columns([2, 3])
with left:
    st.subheader("Inputs")
    with st.form("calc"):
        values = {}
        for field in FIELDS:
            values[field["name"]] = st.number_input(
                field["label"], min_value=0.0, value=0.0, step=1.0, key=f"in_{field['name']}"
            )
        run = st.form_submit_button("Calculate", type="primary", use_container_width=True)

with right:
    st.subheader(SPEC["formula_label"])
    if run:
        try:
            result = float(eval(SPEC["formula"], {"__builtins__": {}}, {
                **values, "monthly_payment": monthly_payment, "future_value": future_value, "math": math,
            }))
        except Exception as exc:  # noqa: BLE001 - a bad formula should not kill the app
            st.error(f"Could not calculate: {exc}")
        else:
            st.metric(SPEC["formula_label"], f"{result:,.2f}")
            save(values, result)
            st.caption("Saved to history below.")
    else:
        st.metric(SPEC["formula_label"], "—")
        st.caption("Enter values and press Calculate.")

st.divider()
history = fetch()
st.subheader(f"History ({len(history)})")
if history.empty:
    st.info("No calculations yet.")
else:
    st.dataframe(history.drop(columns=["id"], errors="ignore"), use_container_width=True, hide_index=True)
    st.download_button(
        "Download CSV",
        history.to_csv(index=False).encode("utf-8"),
        file_name=f"{SPEC['slug']}-history.csv",
        mime="text/csv",
    )
