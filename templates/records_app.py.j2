"""Streamlit app generated by the App Engine. Built from a spec, runs standalone."""
import json
import os
import sqlite3
from datetime import date

import pandas as pd
import streamlit as st

SPEC = json.loads(r'''{{ spec_json }}''')
FIELDS = SPEC["fields"]
DB_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "data.sqlite")
COLUMNS = {"number": "REAL", "date": "TEXT", "bool": "INTEGER"}


def sql_type(ftype: str) -> str:
    return COLUMNS.get(ftype, "TEXT")


def init_db() -> None:
    cols = ", ".join(f'"{f["name"]}" {sql_type(f["type"])}' for f in FIELDS)
    with sqlite3.connect(DB_PATH) as conn:
        conn.execute(
            f'CREATE TABLE IF NOT EXISTS items (id INTEGER PRIMARY KEY AUTOINCREMENT, '
            f'created_at TEXT NOT NULL, {cols})'
        )


def add(values: dict) -> None:
    names = ", ".join(f'"{k}"' for k in values)
    marks = ", ".join("?" for _ in values)
    with sqlite3.connect(DB_PATH) as conn:
        conn.execute(
            f"INSERT INTO items (created_at, {names}) VALUES (?, {marks})",
            (date.today().isoformat(), *values.values()),
        )


def fetch() -> pd.DataFrame:
    with sqlite3.connect(DB_PATH) as conn:
        frame = pd.read_sql_query("SELECT * FROM items ORDER BY id DESC", conn)
    return frame


def delete(ids: list[int]) -> None:
    if not ids:
        return
    marks = ", ".join("?" for _ in ids)
    with sqlite3.connect(DB_PATH) as conn:
        conn.execute(f"DELETE FROM items WHERE id IN ({marks})", ids)


def render_input(field: dict):
    label = field["label"] + (" *" if field.get("required") else "")
    key = f'input_{field["name"]}'
    if field["type"] == "number":
        return st.number_input(label, min_value=0.0, step=1.0, value=0.0, key=key)
    if field["type"] == "date":
        return st.date_input(label, value=date.today(), key=key).isoformat()
    if field["type"] == "select":
        return st.selectbox(label, field.get("options") or ["Other"], key=key)
    if field["type"] == "long_text":
        return st.text_area(label, key=key, height=80)
    if field["type"] == "bool":
        return st.checkbox(label, key=key)
    return st.text_input(label, key=key)


init_db()
st.set_page_config(page_title=SPEC["name"], page_icon="🗂", layout="wide")
st.title(SPEC["name"])
st.caption(SPEC["description"])

frame = fetch()
numeric = [f for f in FIELDS if f["type"] == "number"]
selects = [f for f in FIELDS if f["type"] == "select"]
date_field = next((f["name"] for f in FIELDS if f["type"] == "date"), None)

with st.sidebar:
    st.header("Add")
    with st.form("add_form", clear_on_submit=True):
        values = {f["name"]: render_input(f) for f in FIELDS}
        submitted = st.form_submit_button("Save", type="primary", use_container_width=True)
    if submitted:
        missing = [f["label"] for f in FIELDS if f.get("required") and values.get(f["name"]) in (None, "")]
        if missing:
            st.error("Required: " + ", ".join(missing))
        else:
            add(values)
            st.success("Saved")
            st.rerun()

    if not frame.empty:
        st.divider()
        st.caption("Remove entries")
        to_delete = st.multiselect("Rows", frame["id"].tolist(), label_visibility="collapsed")
        if st.button("Delete selected", disabled=not to_delete, use_container_width=True):
            delete(to_delete)
            st.rerun()

c1, c2, c3, c4 = st.columns(4)
c1.metric("Records", len(frame))
if numeric:
    total = float(frame[numeric[0]["name"]].fillna(0).sum()) if not frame.empty else 0.0
    c2.metric(f"Total {numeric[0]['label'].lower()}", f"{total:,.1f}")
    if len(numeric) > 1 and not frame.empty:
        avg = float(frame[numeric[1]["name"]].fillna(0).mean())
        c3.metric(f"Average {numeric[1]['label'].lower()}", f"{avg:,.1f}")
if selects and not frame.empty:
    c4.metric(f"{selects[0]['label']}s used", frame[selects[0]["name"]].nunique())

if frame.empty:
    st.info("Nothing yet — add your first entry in the sidebar.")
    st.stop()

filters = st.columns([2, 2, 1])
query = filters[0].text_input("Search", placeholder="Search across all text fields")
shown = frame.copy()
if query:
    text_cols = [c for c in shown.columns if shown[c].dtype == object and c != "created_at"]
    mask = shown[text_cols].astype(str).apply(lambda col: col.str.contains(query, case=False, na=False)).any(axis=1)
    shown = shown[mask]
if selects:
    picked = filters[1].multiselect(selects[0]["label"], selects[0].get("options", []))
    if picked:
        shown = shown[shown[selects[0]["name"]].isin(picked)]

st.dataframe(
    shown.drop(columns=["created_at"], errors="ignore"),
    use_container_width=True,
    hide_index=True,
    column_config={"id": st.column_config.NumberColumn("ID", width="small")},
)

left, right = st.columns([3, 2])
with left:
    if selects and numeric:
        st.subheader(f"{numeric[0]['label']} by {selects[0]['label'].lower()}")
        grouped = shown.groupby(selects[0]["name"])[numeric[0]["name"]].sum().sort_values(ascending=False)
        st.bar_chart(grouped)
    elif date_field and numeric:
        st.subheader(f"{numeric[0]['label']} over time")
        series = shown.copy()
        series["month"] = pd.to_datetime(series[date_field], errors="coerce").dt.to_period("M").astype(str)
        st.line_chart(series.groupby("month")[numeric[0]["name"]].sum())
with right:
    st.subheader("Export")
    st.download_button(
        "Download CSV",
        shown.to_csv(index=False).encode("utf-8"),
        file_name=f"{SPEC['slug']}.csv",
        mime="text/csv",
        use_container_width=True,
    )
    st.caption(f"{len(shown)} of {len(frame)} rows shown.")
